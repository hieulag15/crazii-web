//@version=6
// © hieulag - 2026. Indicator cá nhân: Auto Elliott Wave + Fibonacci + tham chiếu HTF.
// Nền tảng: ZigZag (pivot) -> gán nhãn sóng 1-2-3-4-5 / A-B-C -> kiểm tra quy tắc -> Fib extension.
// MỚI (v3): DỰ ĐOÁN ĐA KỊCH BẢN - sinh nhiều kịch bản khả thi phía sau (KB1/KB2/KB3), chọn qua Settings.
//           Tự ẩn kịch bản khi giá đã PHÁ VỠ mức invalidation (không còn để dự báo cũ trơ lại).
//           Ví dụ: sau 1-2-3-4-5 tăng -> KB1 ABC Zigzag sâu / KB2 ABC phẳng / KB3 tiếp diễn phá đỉnh.
// LƯU Ý: Pine KHÔNG hỗ trợ bấm nút trên chart. Việc "chọn kịch bản" làm qua ô chọn trong phần Cài đặt (⚙).
//        Đếm sóng + dự đoán chỉ mang tính tham khảo xác suất, KHÔNG phải lời khuyên đầu tư.
indicator("Auto Elliott Wave + Fib BY hieulag", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100, max_bars_back=5000)

// ==========================================
// 0. KIỂU DỮ LIỆU KỊCH BẢN
// ==========================================
type Scenario
    string        name
    string        desc
    array<float>  ys        // chuỗi giá các điểm sóng dự đoán
    array<string> txts      // nhãn mỗi điểm (A, B, C, (2), ...)
    float         zTop = na // vùng mục tiêu: biên trên
    float         zBot = na // vùng mục tiêu: biên dưới
    float         invalid = na   // mức giá phá vỡ kịch bản
    bool          invalidUp = true // true: phá khi giá > invalid; false: phá khi giá < invalid
    color         col = color.yellow

// ==========================================
// 1. INPUTS
// ==========================================
gZig      = "① ZigZag (Cấu trúc sóng khung hiện tại)"
depth     = input.int(8, "Độ nhạy ZigZag (Pivot Depth)", minval=2, maxval=100, group=gZig, tooltip="Số nến trái/phải để xác nhận đỉnh/đáy. Số lớn = sóng lớn, mượt hơn.")
minLegAtr = input.float(2.0, "Bộ lọc nhiễu: chân sóng tối thiểu (x ATR)", minval=0.0, step=0.5, group=gZig, tooltip="Bỏ qua các nhịp đảo chiều nhỏ hơn N lần ATR. Tăng lên (3-5) để gộp nhiễu, tránh sóng 3 bị 'ngắn nhất' do lẫn cấp độ sóng.")
maxPivots = input.int(10, "Số điểm ZigZag dùng để đếm sóng", minval=6, maxval=30, group=gZig)
showZig   = input.bool(true, "Vẽ đường ZigZag gốc", group=gZig)
colZig    = input.color(color.new(color.gray, 40), "Màu đường ZigZag", group=gZig)

gWave     = "② Nhãn sóng Elliott (Khung hiện tại)"
showWaves = input.bool(true, "Vẽ & đánh số sóng", group=gWave)
colImpulse= input.color(#2962ff, "Màu chân sóng đẩy (1-5)", group=gWave)
colCorr   = input.color(#e91e63, "Màu chân sóng điều chỉnh (A-B-C)", group=gWave)
colLabel  = input.color(#ff9800, "Màu nền nhãn số sóng", group=gWave)

gFib      = "③ Fibonacci Extension (Mục tiêu sóng)"
showFib   = input.bool(true, "Vẽ mục tiêu Fib cho sóng đang hình thành", group=gFib)
colFib    = input.color(color.new(#00bcd4, 0), "Màu đường Fib mục tiêu", group=gFib)
fibRight  = input.int(20, "Độ dài kéo dài đường Fib (nến)", minval=5, maxval=100, group=gFib)

gHtf      = "④ Tham chiếu Khung Lớn (HTF)"
showHtf   = input.bool(true, "Vẽ cấu trúc sóng khung lớn (chồng lên)", group=gHtf)
htfTf     = input.timeframe("240", "Khung thời gian tham chiếu", group=gHtf, tooltip="Để trống = tự động. Ví dụ: 60, 240, D, W.")
depthHtf  = input.int(6, "Độ nhạy ZigZag khung lớn", minval=2, maxval=100, group=gHtf)
colHtfUp  = input.color(color.new(#26a69a, 0), "Màu sóng đẩy HTF", group=gHtf)
colHtfDn  = input.color(color.new(#ef5350, 0), "Màu sóng điều chỉnh HTF", group=gHtf)

gDash     = "⑤ Bảng thông tin"
showDash  = input.bool(true, "Hiển thị Dashboard", group=gDash)
dashPos   = input.string("Trên phải", "Vị trí bảng", options=["Trên phải","Trên trái","Dưới phải","Dưới trái"], group=gDash)

gProj     = "⑥ DỰ ĐOÁN ĐA KỊCH BẢN (Projection)"
showProj  = input.bool(true, "Bật dự đoán kịch bản (nét đứt)", group=gProj, tooltip="Sinh nhiều kịch bản khả thi phía sau dựa trên Fibonacci và tự ẩn khi giá phá vỡ.")
scenarioSel = input.string("Tự động", "Kịch bản hiển thị", options=["Tự động","Kịch bản 1","Kịch bản 2","Kịch bản 3","Tất cả"], group=gProj, tooltip="Pine không bấm nút trên chart được — chọn kịch bản muốn xem ở đây. 'Tự động' = kịch bản xác suất cao nhất CÒN hiệu lực.")
hideInvalid = input.bool(true, "Ẩn kịch bản giá đã PHÁ VỠ", group=gProj, tooltip="Khi giá vượt mức invalidation của 1 kịch bản thì không vẽ nó nữa.")
projStep  = input.int(10, "Khoảng cách mỗi sóng dự đoán (nến)", minval=3, maxval=50, group=gProj)
showZone  = input.bool(true, "Vẽ vùng mục tiêu điều chỉnh", group=gProj)
colZone   = input.color(color.new(#ffeb3b, 85), "Màu nền vùng mục tiêu", group=gProj)
colProj   = input.color(color.new(#ffeb3b, 0), "Màu KB1", group=gProj)
colProj2  = input.color(color.new(#00e676, 0), "Màu KB2", group=gProj)
colProj3  = input.color(color.new(#ff4081, 0), "Màu KB3", group=gProj)

// ==========================================
// 2. HÀM DÙNG CHUNG
// ==========================================
// Thêm 1 pivot vào mảng zigzag (giữ điểm cực trị nếu trùng chiều). x có thể là bar_index HOẶC time.
f_addPivot(float[] zp, int[] zx, int[] zd, float price, int x, int dir, int cap, float minMove) =>
    n = array.size(zp)
    if n == 0
        array.push(zp, price), array.push(zx, x), array.push(zd, dir)
    else
        lastDir = array.get(zd, n - 1)
        lastPrice = array.get(zp, n - 1)
        if lastDir == dir
            if (dir == 1 and price > lastPrice) or (dir == -1 and price < lastPrice)
                array.set(zp, n - 1, price)
                array.set(zx, n - 1, x)
        else
            if math.abs(price - lastPrice) >= minMove
                array.push(zp, price), array.push(zx, x), array.push(zd, dir)
    while array.size(zp) > cap
        array.shift(zp), array.shift(zx), array.shift(zd)

// Kiểm 3 quy tắc cho 1 điểm gốc ứng viên (impulse 5 sóng). Trả [hợp lệ, sóng3-dài-nhất].
f_checkImpulse(float[] zp, int o, bool bull) =>
    p0 = array.get(zp, o)
    p1 = array.get(zp, o + 1)
    p2 = array.get(zp, o + 2)
    p3 = array.get(zp, o + 3)
    p4 = array.get(zp, o + 4)
    p5 = array.get(zp, o + 5)
    len1 = math.abs(p1 - p0)
    len3 = math.abs(p3 - p2)
    len5 = math.abs(p5 - p4)
    r1 = bull ? p2 > p0 : p2 < p0
    r2 = bull ? p4 > p1 : p4 < p1
    r3 = not (len3 < len1 and len3 < len5)
    w3Longest = len3 >= len1 and len3 >= len5
    [r1 and r2 and r3, w3Longest]

// Chọn điểm gốc: ưu tiên cách đếm thỏa 3 quy tắc (đặc biệt sóng 3 không ngắn nhất).
f_pickOrigin(float[] zp, int[] zd, int maxP) =>
    n = array.size(zp)
    originPos = -1
    trendBull = true
    isValid = false
    if n >= 3
        lo = math.max(0, n - maxP)
        hi = n - 6
        best1 = -1
        best1Bull = true
        best1Span = -1.0
        best2 = -1
        best2Bull = true
        best2Span = -1.0
        if hi >= lo
            for o = lo to hi
                bull = array.get(zd, o) == -1
                [ok, w3Long] = f_checkImpulse(zp, o, bull)
                if ok
                    span = math.abs(array.get(zp, o + 1) - array.get(zp, o)) + math.abs(array.get(zp, o + 3) - array.get(zp, o + 2)) + math.abs(array.get(zp, o + 5) - array.get(zp, o + 4))
                    if w3Long and span > best1Span
                        best1 := o
                        best1Bull := bull
                        best1Span := span
                    if span > best2Span
                        best2 := o
                        best2Bull := bull
                        best2Span := span
        if best1 >= 0
            originPos := best1
            trendBull := best1Bull
            isValid   := true
        else if best2 >= 0
            originPos := best2
            trendBull := best2Bull
            isValid   := true
        if not isValid
            minPos = lo
            maxPos = lo
            minV = array.get(zp, lo)
            maxV = array.get(zp, lo)
            for k = lo to n - 1
                v = array.get(zp, k)
                if v < minV
                    minV := v
                    minPos := k
                if v > maxV
                    maxV := v
                    maxPos := k
            trendBull := maxPos > minPos
            originPos := trendBull ? minPos : maxPos
            if originPos >= n - 1
                originPos := math.max(lo, n - 2)
                trendBull := array.get(zp, n - 1) > array.get(zp, originPos)
    [originPos, trendBull, isValid]

f_waveLabel(step) =>
    step == 1 ? "1" : step == 2 ? "2" : step == 3 ? "3" : step == 4 ? "4" : step == 5 ? "5" : step == 6 ? "A" : step == 7 ? "B" : step == 8 ? "C" : ""

f_waveLabelC(step) =>
    step == 1 ? "A" : step == 2 ? "B" : step == 3 ? "C" : step == 4 ? "D" : step == 5 ? "E" : ""

// Kiểm cấu trúc ĐIỀU CHỈNH ABC.
f_checkABC(float[] zp, int o, int legsDone) =>
    plausible = false
    if legsDone >= 2 and o + 2 <= array.size(zp) - 1
        p0 = array.get(zp, o)
        p1 = array.get(zp, o + 1)
        p2 = array.get(zp, o + 2)
        legA = math.abs(p1 - p0)
        legB = math.abs(p2 - p1)
        okB = legA > 0 and (legB / legA) >= 0.2 and (legB / legA) <= 1.05
        if legsDone == 2
            plausible := okB
        else if o + 3 <= array.size(zp) - 1
            p3 = array.get(zp, o + 3)
            legC = math.abs(p3 - p2)
            okC = legA > 0 and (legC / legA) >= 0.5
            plausible := okB and okC
    plausible

// Vẽ 1 đường mục tiêu Fibonacci (ngang) + nhãn
f_pushFib(line[] fl, label[] flb, int xL, int xR, float price, string txt, color c) =>
    l = line.new(xL, price, xR, price, color=c, width=1, style=line.style_dotted)
    array.push(fl, l)
    b = label.new(xR, price, txt, style=label.style_label_left, color=color.new(c, 20), textcolor=color.white, size=size.small)
    array.push(flb, b)

// Kịch bản còn hiệu lực không?
//  - notBroken: giá CHƯA phá mức invalidation (đi sai hướng dự báo).
//  - notDone:   giá CHƯA chạy vượt qua MỤC TIÊU CUỐI (điểm cuối ys) theo đúng hướng.
//    anchor = giá pivot gốc để suy ra hướng của nhịp dự báo (lên/xuống).
//  -> Khi giá đã chạy "tít" qua điểm cuối, kịch bản hết giá trị -> ẩn.
f_valid(Scenario s, float cur, float anchor) =>
    notBroken = na(s.invalid) ? true : (s.invalidUp ? cur <= s.invalid : cur >= s.invalid)
    done = false
    m = array.size(s.ys)
    if m > 0
        fin = array.get(s.ys, m - 1)
        down = fin < anchor
        done := down ? cur <= fin : cur >= fin
    notBroken and not done

// Vẽ đường DỰ ĐOÁN (nét đứt) nối các điểm sóng + nhãn có tiền tố KBn.
f_drawProj(line[] pl, label[] plb, int startX, float startY, array<float> ys, array<string> txts, int step, color c, string prefix) =>
    px = startX
    py = startY
    if array.size(ys) > 0
        for i = 0 to array.size(ys) - 1
            nx = px + step
            ny = array.get(ys, i)
            ln = line.new(px, py, nx, ny, color=c, width=2, style=line.style_dashed)
            array.push(pl, ln)
            stl = ny >= py ? label.style_label_down : label.style_label_up
            lb = label.new(nx, ny, prefix + array.get(txts, i) + "?", style=stl, color=color.new(c, 15), textcolor=color.black, size=size.small)
            array.push(plb, lb)
            px := nx
            py := ny

// Sinh DANH SÁCH kịch bản khả thi dựa trên cấu trúc hiện tại.
f_buildScenarios(float[] zp, int oPos, bool tBull, bool corrMode, int legsDone, color c1, color c2, color c3) =>
    arr = array.new<Scenario>()
    if oPos >= 0
        dir  = tBull ? 1.0 : -1.0
        p0   = array.get(zp, oPos)
        p1   = array.get(zp, oPos + 1)
        len1 = math.abs(p1 - p0)

        if not corrMode and legsDone >= 5
            // 5 sóng đẩy xong -> các kịch bản điều chỉnh / tiếp diễn
            pEnd = array.get(zp, oPos + 5)
            p4v  = array.get(zp, oPos + 4)
            net  = math.abs(pEnd - p0)
            // KB1: ABC Zigzag sâu (A≈0.5, C≈0.618)
            y1 = array.new_float(), t1 = array.new_string()
            a1 = pEnd - dir * net * 0.5
            b1 = a1 + dir * (net * 0.5) * 0.382
            c1v = pEnd - dir * net * 0.618
            array.push(y1, a1), array.push(t1, "A")
            array.push(y1, b1), array.push(t1, "B")
            array.push(y1, c1v), array.push(t1, "C")
            array.push(arr, Scenario.new("KB1 ABC Zigzag (sâu)", "A≈0.5, C≈0.618 cả nhịp đẩy. Phổ biến nhất.", y1, t1, pEnd - dir * net * 0.5, pEnd - dir * net * 0.618, pEnd, tBull, c1))
            // KB2: ABC phẳng / nông (A≈0.382, C≈0.5)
            y2 = array.new_float(), t2 = array.new_string()
            a2 = pEnd - dir * net * 0.382
            b2 = a2 + dir * (net * 0.382) * 0.9
            c2v = pEnd - dir * net * 0.5
            array.push(y2, a2), array.push(t2, "A")
            array.push(y2, b2), array.push(t2, "B")
            array.push(y2, c2v), array.push(t2, "C")
            array.push(arr, Scenario.new("KB2 ABC phẳng (nông)", "Điều chỉnh nông 0.382–0.5, B hồi sâu (Flat).", y2, t2, pEnd - dir * net * 0.382, pEnd - dir * net * 0.5, pEnd, tBull, c2))
            // KB3: Tiếp diễn xu hướng (hồi nông rồi phá đỉnh)
            y3 = array.new_float(), t3 = array.new_string()
            pull = pEnd - dir * net * 0.236
            up   = pEnd + dir * net * 0.618
            array.push(y3, pull), array.push(t3, "(2)")
            array.push(y3, up), array.push(t3, "(3)↑")
            array.push(arr, Scenario.new("KB3 Tiếp diễn xu hướng", "Hồi rất nông 0.236 rồi phá đỉnh — 5 sóng vừa rồi là (1)/(3) cấp lớn hơn.", y3, t3, na, na, p4v, not tBull, c3))

        else if corrMode and legsDone == 1
            // A xong, B đang chạy -> 3 độ sâu B khác nhau, mỗi cái nối tới C≈A
            dirA = (p1 > p0) ? 1.0 : -1.0
            legA = len1
            bd1 = p1 - dirA * legA * 0.5
            bd2 = p1 - dirA * legA * 0.382
            bd3 = p1 - dirA * legA * 0.618
            yA = array.new_float(), tA = array.new_string()
            array.push(yA, bd1), array.push(tA, "B"), array.push(yA, bd1 + dirA * legA), array.push(tA, "C")
            array.push(arr, Scenario.new("KB1 B hồi 0.5 → C≈A", "Sóng B hồi 50% A, sóng C xấp xỉ A.", yA, tA, na, na, na, true, c1))
            yB = array.new_float(), tB = array.new_string()
            array.push(yB, bd2), array.push(tB, "B"), array.push(yB, bd2 + dirA * legA), array.push(tB, "C")
            array.push(arr, Scenario.new("KB2 B hồi 0.382 → C≈A", "Sóng B nông, C xấp xỉ A.", yB, tB, na, na, na, true, c2))
            yC = array.new_float(), tC = array.new_string()
            array.push(yC, bd3), array.push(tC, "B"), array.push(yC, bd3 + dirA * legA), array.push(tC, "C")
            array.push(arr, Scenario.new("KB3 B hồi 0.618 → C≈A", "Sóng B sâu, C xấp xỉ A.", yC, tC, na, na, na, true, c3))

        else if corrMode and legsDone == 2
            // A,B xong, C đang chạy -> 3 mục tiêu C
            p2v  = array.get(zp, oPos + 2)
            dirA = (p1 > p0) ? 1.0 : -1.0
            legA = len1
            invUp = dirA < 0
            // KB1 C = A
            yc1 = array.new_float(), tc1 = array.new_string()
            cv1 = p2v + dirA * legA * 1.0
            array.push(yc1, cv1), array.push(tc1, "C")
            array.push(arr, Scenario.new("KB1 C = A (1.0)", "Sóng C bằng sóng A — ABC Zigzag chuẩn.", yc1, tc1, p2v + dirA * legA * 0.618, p2v + dirA * legA * 1.0, p2v, invUp, c1))
            // KB2 C = 1.618A
            yc2 = array.new_float(), tc2 = array.new_string()
            cv2 = p2v + dirA * legA * 1.618
            array.push(yc2, cv2), array.push(tc2, "C")
            array.push(arr, Scenario.new("KB2 C = 1.618A (mở rộng)", "Sóng C mở rộng 1.618×A.", yc2, tc2, p2v + dirA * legA * 1.0, p2v + dirA * legA * 1.618, p2v, invUp, c2))
            // KB3 C = 0.618A (cụt) rồi xu hướng chính quay lại
            yc3 = array.new_float(), tc3 = array.new_string()
            cv3 = p2v + dirA * legA * 0.618
            w1  = cv3 + dir * legA * 0.618
            array.push(yc3, cv3), array.push(tc3, "C"), array.push(yc3, w1), array.push(tc3, "1")
            array.push(arr, Scenario.new("KB3 C cụt → xu hướng chính", "C ngắn (0.618A) rồi xu hướng chính tiếp diễn.", yc3, tc3, na, na, p2v, invUp, c3))

        else if corrMode and legsDone >= 3
            // ABC có vẻ xong -> xu hướng chính quay lại
            startY = array.get(zp, array.size(zp) - 1)
            legA   = len1
            yR = array.new_float(), tR = array.new_string()
            array.push(yR, startY + dir * legA * 0.618), array.push(tR, "1")
            array.push(yR, startY + dir * legA * 1.0), array.push(tR, "3")
            array.push(arr, Scenario.new("KB1 ABC xong → sóng đẩy mới", "Điều chỉnh hoàn tất, chờ sóng đẩy mới theo xu hướng chính.", yR, tR, na, na, na, true, c1))
    arr

// Xóa đối tượng đã vẽ
f_clearLines(line[] ls) =>
    if array.size(ls) > 0
        for i = 0 to array.size(ls) - 1
            line.delete(array.get(ls, i))
        array.clear(ls)
f_clearLabels(label[] lbs) =>
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
        array.clear(lbs)
f_clearBoxes(box[] bs) =>
    if array.size(bs) > 0
        for i = 0 to array.size(bs) - 1
            box.delete(array.get(bs, i))
        array.clear(bs)

// Vẽ các chân sóng + nhãn số.
f_drawWaves(float[] zp, int[] zx, int[] zd, int originPos, bool trendBull, line[] outL, label[] outLb, bool xTime, color cImp, color cCorr, color cLab, int mode) =>
    n = array.size(zp)
    if originPos >= 0 and originPos < n - 1
        for k = originPos to n - 2
            x1 = array.get(zx, k)
            y1 = array.get(zp, k)
            x2 = array.get(zx, k + 1)
            y2 = array.get(zp, k + 1)
            step = (k + 1) - originPos
            lc = mode == 0 ? (step <= 5 ? cImp : cCorr) : mode == 1 ? cCorr : color.new(color.gray, 55)
            lw = mode == 2 ? 1 : 2
            lstyle = mode == 2 ? line.style_dashed : line.style_solid
            ln = xTime ? line.new(x1, y1, x2, y2, xloc=xloc.bar_time, color=lc, width=lw, style=lstyle) : line.new(x1, y1, x2, y2, color=lc, width=lw, style=lstyle)
            array.push(outL, ln)
            txt = mode == 0 ? f_waveLabel(step) : mode == 1 ? f_waveLabelC(step) : ""
            if txt != ""
                isHigh = array.get(zd, k + 1) == 1
                stl = isHigh ? label.style_label_down : label.style_label_up
                lb = xTime ? label.new(x2, y2, txt, xloc=xloc.bar_time, style=stl, color=cLab, textcolor=color.white, size=size.small) : label.new(x2, y2, txt, style=stl, color=cLab, textcolor=color.white, size=size.small)
                array.push(outLb, lb)

// Kiểm tra 3 quy tắc Elliott. Trả [hợp lệ, mô tả, số sóng].
f_validate(float[] zp, int originPos, bool trendBull) =>
    n = array.size(zp)
    valid = false
    msg = "Chưa đủ 5 sóng"
    waveCnt = originPos >= 0 ? (n - 1) - originPos : 0
    if originPos >= 0 and (n - originPos) >= 6
        p0 = array.get(zp, originPos)
        p1 = array.get(zp, originPos + 1)
        p2 = array.get(zp, originPos + 2)
        p3 = array.get(zp, originPos + 3)
        p4 = array.get(zp, originPos + 4)
        p5 = array.get(zp, originPos + 5)
        len1 = math.abs(p1 - p0)
        len3 = math.abs(p3 - p2)
        len5 = math.abs(p5 - p4)
        r1 = trendBull ? p2 > p0 : p2 < p0
        r2 = trendBull ? p4 > p1 : p4 < p1
        r3 = not (len3 < len1 and len3 < len5)
        valid := r1 and r2 and r3
        w3Longest = len3 >= len1 and len3 >= len5
        msg := "R1:" + (r1 ? "✔" : "✗") + " R2:" + (r2 ? "✔" : "✗") + " R3:" + (r3 ? "✔" : "✗") + (w3Longest ? " | W3 dài nhất ✦" : "")
    [valid, msg, waveCnt]

// ==========================================
// 3. XÂY ZIGZAG KHUNG HIỆN TẠI
// ==========================================
var float[] zzP = array.new_float()
var int[]   zzX = array.new_int()
var int[]   zzD = array.new_int()

float zzAtr = ta.atr(14)
float ltfMinMove = zzAtr * minLegAtr

ph = ta.pivothigh(depth, depth)
pl = ta.pivotlow(depth, depth)
if not na(ph)
    f_addPivot(zzP, zzX, zzD, ph, bar_index - depth, 1, 50, ltfMinMove)
if not na(pl)
    f_addPivot(zzP, zzX, zzD, pl, bar_index - depth, -1, 50, ltfMinMove)

// ==========================================
// 4. XÂY ZIGZAG KHUNG LỚN (HTF)
// ==========================================
var float[] hzP = array.new_float()
var int[]   hzX = array.new_int()
var int[]   hzD = array.new_int()

[hPh, hPl, hT, hAtr] = request.security(syminfo.tickerid, htfTf, [ta.pivothigh(depthHtf, depthHtf), ta.pivotlow(depthHtf, depthHtf), time[depthHtf], ta.atr(14)], lookahead=barmerge.lookahead_off)

bool htfValid = timeframe.in_seconds(htfTf) > timeframe.in_seconds()
float htfMinMove = (na(hAtr) ? 0.0 : hAtr) * minLegAtr

var int lastHiT = na
var int lastLoT = na
if showHtf and htfValid
    if not na(hPh) and (na(lastHiT) or hT != lastHiT)
        f_addPivot(hzP, hzX, hzD, hPh, hT, 1, 40, htfMinMove)
        lastHiT := hT
    if not na(hPl) and (na(lastLoT) or hT != lastLoT)
        f_addPivot(hzP, hzX, hzD, hPl, hT, -1, 40, htfMinMove)
        lastLoT := hT

// ==========================================
// 5. BIẾN LƯU ĐỐI TƯỢNG ĐỒ HỌA
// ==========================================
var line[]  ltfLines  = array.new_line()
var label[] ltfLabels = array.new_label()
var line[]  zigLines  = array.new_line()
var line[]  fibLines  = array.new_line()
var label[] fibLabels = array.new_label()
var line[]  htfLines  = array.new_line()
var label[] htfLabels = array.new_label()
var line[]  projLines  = array.new_line()
var label[] projLabels = array.new_label()
var box[]   projBoxes  = array.new_box()

// ==========================================
// 6. VẼ (chỉ trên nến cuối)
// ==========================================
if barstate.islast
    f_clearLines(ltfLines)
    f_clearLabels(ltfLabels)
    f_clearLines(zigLines)
    f_clearLines(fibLines)
    f_clearLabels(fibLabels)
    f_clearLines(htfLines)
    f_clearLabels(htfLabels)
    f_clearLines(projLines)
    f_clearLabels(projLabels)
    f_clearBoxes(projBoxes)

    nz = array.size(zzP)
    if showZig and nz >= 2
        for k = 0 to nz - 2
            zl = line.new(array.get(zzX, k), array.get(zzP, k), array.get(zzX, k + 1), array.get(zzP, k + 1), color=colZig, width=1, style=line.style_solid)
            array.push(zigLines, zl)

    [oPos, tBull, oValid] = f_pickOrigin(zzP, zzD, maxPivots)
    n = array.size(zzP)
    legsDone = oPos >= 0 ? (n - 1) - oPos : 0

    lMode     = 2
    corrMode  = false
    structTxt = "Chưa đủ dữ liệu"
    if oPos >= 0
        if oValid
            lMode     := 0
            corrMode  := false
            structTxt := "Sóng đẩy (Impulse)"
        else
            abcOk = f_checkABC(zzP, oPos, legsDone)
            if abcOk
                lMode     := 1
                corrMode  := true
                structTxt := legsDone >= 3 ? "Điều chỉnh ABC" : "ABC (đang chạy)"
            else
                lMode     := 2
                corrMode  := false
                structTxt := legsDone >= 5 ? "Chưa xác định (không phải impulse)" : "Đang hình thành"

    if showWaves
        f_drawWaves(zzP, zzX, zzD, oPos, tBull, ltfLines, ltfLabels, false, colImpulse, colCorr, colLabel, lMode)

    [isValid, ruleMsg, wCnt] = f_validate(zzP, oPos, tBull)

    // --- Fibonacci: mục tiêu cho sóng đang chạy dở ---
    if showFib and oPos >= 0 and legsDone >= 1 and lMode != 2
        dir   = tBull ? 1.0 : -1.0
        xLast = array.get(zzX, n - 1)
        xEnd  = bar_index + fibRight
        p0    = array.get(zzP, oPos)
        p1    = array.get(zzP, oPos + 1)
        len1  = math.abs(p1 - p0)
        if not corrMode
            if legsDone >= 5
                pEnd    = array.get(zzP, oPos + 5)
                netMove = math.abs(pEnd - p0)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, pEnd - dir * netMove * 0.382, "ĐC 0.382", colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, pEnd - dir * netMove * 0.5,   "ĐC 0.5",   colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, pEnd - dir * netMove * 0.618, "ĐC 0.618", colFib)
        else
            dirA = (p1 > p0) ? 1.0 : -1.0
            legA = len1
            if legsDone == 1
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p1 - dirA * legA * 0.382, "B 0.382", colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p1 - dirA * legA * 0.5,   "B 0.5",   colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p1 - dirA * legA * 0.618, "B 0.618", colFib)
            else if legsDone == 2
                p2 = array.get(zzP, oPos + 2)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p2 + dirA * legA * 0.618, "C 0.618A", colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p2 + dirA * legA * 1.0,   "C = A",    colFib)
                f_pushFib(fibLines, fibLabels, xLast, xEnd, p2 + dirA * legA * 1.618, "C 1.618A", colFib)

    // --- DỰ ĐOÁN ĐA KỊCH BẢN (tự ẩn khi giá phá vỡ) ---
    projSelName = "—"
    projZoneTxt = "—"
    projSummary = "—"
    if showProj and oPos >= 0 and lMode != 2 and n >= 2
        scens = f_buildScenarios(zzP, oPos, tBull, corrMode, legsDone, colProj, colProj2, colProj3)
        cur = close
        ns = array.size(scens)
        startX = array.get(zzX, n - 1)
        startY = array.get(zzP, n - 1)
        if ns > 0
            summ = ""
            autoIdx = -1
            for i = 0 to ns - 1
                okv = f_valid(array.get(scens, i), cur, startY)
                summ := summ + "KB" + str.tostring(i + 1) + (okv ? "✅ " : "❌ ")
                if okv and autoIdx == -1
                    autoIdx := i
            projSummary := summ

            drawAll = scenarioSel == "Tất cả"
            selIdx = scenarioSel == "Kịch bản 1" ? 0 : scenarioSel == "Kịch bản 2" ? 1 : scenarioSel == "Kịch bản 3" ? 2 : autoIdx

            for i = 0 to ns - 1
                s = array.get(scens, i)
                okv = f_valid(s, cur, startY)
                doDraw = drawAll or i == selIdx
                if doDraw and (okv or not hideInvalid)
                    f_drawProj(projLines, projLabels, startX, startY, s.ys, s.txts, projStep, s.col, "KB" + str.tostring(i + 1) + "·")
                    if showZone and not na(s.zTop) and not na(s.zBot)
                        zT = math.max(s.zTop, s.zBot)
                        zB = math.min(s.zTop, s.zBot)
                        zR = bar_index + projStep * array.size(s.ys) + fibRight
                        bx = box.new(startX, zT, zR, zB, bgcolor=colZone, border_color=color.new(s.col, 40), border_width=1, border_style=line.style_dashed)
                        array.push(projBoxes, bx)
                        lbz = label.new(zR, (zT + zB) / 2, "KB" + str.tostring(i + 1) + " mục tiêu", style=label.style_label_left, color=color.new(s.col, 30), textcolor=color.black, size=size.small)
                        array.push(projLabels, lbz)
                        if i == selIdx or not drawAll
                            projZoneTxt := str.tostring(zB, format.mintick) + " – " + str.tostring(zT, format.mintick)

            if drawAll
                projSelName := "Tất cả (" + str.tostring(ns) + " KB)"
            else if selIdx >= ns or selIdx < 0
                projSelName := autoIdx == -1 and selIdx < 0 ? "Mọi KB đã bị phá — chờ cấu trúc mới" : "KB đã chọn không có ở cấu trúc này"
            else
                sSel = array.get(scens, selIdx)
                projSelName := sSel.name + (f_valid(sSel, cur, startY) ? "" : " ⚠️ đã phá/đã qua")

    // --- Cấu trúc sóng HTF ---
    htfTrendTxt = "—"
    if showHtf and htfValid and array.size(hzP) >= 2
        [hoPos, htBull, hoValid] = f_pickOrigin(hzP, hzD, maxPivots)
        hLegs = hoPos >= 0 ? (array.size(hzP) - 1) - hoPos : 0
        hMode = hoValid ? 0 : (f_checkABC(hzP, hoPos, hLegs) ? 1 : 2)
        f_drawWaves(hzP, hzX, hzD, hoPos, htBull, htfLines, htfLabels, true, htBull ? colHtfUp : colHtfDn, htBull ? colHtfUp : colHtfDn, htBull ? colHtfUp : colHtfDn, hMode)
        htfTrendTxt := htBull ? "TĂNG (Bull)" : "GIẢM (Bear)"

    // --- Dashboard ---
    if showDash
        posSel = dashPos == "Trên phải" ? position.top_right : dashPos == "Trên trái" ? position.top_left : dashPos == "Dưới phải" ? position.bottom_right : position.bottom_left
        var table dash = na
        dash := table.new(posSel, 2, 10, border_width=1, frame_color=color.gray, frame_width=1, bgcolor=color.new(color.black, 20))
        curTrend = tBull ? "TĂNG (Bull)" : "GIẢM (Bear)"
        curCol   = tBull ? color.teal : color.maroon
        structCol = structTxt == "Sóng đẩy (Impulse)" ? color.green : str.contains(structTxt, "ABC") ? color.blue : color.orange
        table.cell(dash, 0, 0, "hieulag EW", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.normal)
        table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.normal)
        table.cell(dash, 0, 1, "Loại cấu trúc", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 1, structTxt, text_color=color.white, bgcolor=color.new(structCol, 30), text_size=size.small)
        table.cell(dash, 0, 2, "Xu hướng (TF này)", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 2, curTrend, text_color=color.white, bgcolor=color.new(curCol, 30), text_size=size.small)
        table.cell(dash, 0, 3, "Số sóng đã có", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 3, str.tostring(wCnt), text_color=color.white, text_size=size.small)
        table.cell(dash, 0, 4, "Quy tắc EW", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 4, ruleMsg, text_color=color.white, bgcolor=color.new(isValid ? color.green : color.red, 40), text_size=size.small)
        table.cell(dash, 0, 5, "Trạng thái đếm", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 5, isValid ? "HỢP LỆ" : "CẦN CHỈNH TAY", text_color=color.white, bgcolor=color.new(isValid ? color.green : color.orange, 30), text_size=size.small)
        table.cell(dash, 0, 6, "Xu hướng HTF " + htfTf, text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 6, htfTrendTxt, text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
        table.cell(dash, 0, 7, "🔮 KB đang xem", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 7, projSelName, text_color=color.white, bgcolor=color.new(color.purple, 30), text_size=size.small)
        table.cell(dash, 0, 8, "Các kịch bản", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 8, projSummary, text_color=color.white, bgcolor=color.new(color.teal, 40), text_size=size.small)
        table.cell(dash, 0, 9, "Vùng mục tiêu", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 9, projZoneTxt, text_color=color.white, bgcolor=color.new(color.orange, 40), text_size=size.small)

// ==========================================
// 7. ALERT
// ==========================================
alertcondition(not na(ph), title="Pivot Đỉnh mới", message="{{ticker}} vừa tạo Đỉnh ZigZag mới - kiểm tra cấu trúc sóng.")
alertcondition(not na(pl), title="Pivot Đáy mới", message="{{ticker}} vừa tạo Đáy ZigZag mới - kiểm tra cấu trúc sóng.")
